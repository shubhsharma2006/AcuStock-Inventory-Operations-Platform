# ===============================================
# AcuStock Backend Configuration
# ===============================================
# ⚠️ NEVER COMMIT .env TO VERSION CONTROL
# Copy this file to .env and update values for your environment
# ===============================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Values: production | development | test

# Database Configuration
# ⚠️ For production, use MongoDB Atlas or secured instance
# Example: mongodb+srv://user:password@cluster.mongodb.net/acustock?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/acustock

# JWT Configuration
# ⚠️ CRITICAL: Generate a strong, unique secret for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Frontend URL(s) for CORS - comma separated for multiple origins
# Update with your production domain(s)
FRONTEND_URL=http://localhost:3000

# Email Configuration (for password reset, notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Session/Cookie Configuration
SESSION_COOKIE_SECURE=true
# Set to false only in development without HTTPS

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
