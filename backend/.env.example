# ===============================================
# AcuStock Backend Configuration (.env)
# ===============================================
# ⚠️ NEVER COMMIT .env TO VERSION CONTROL
# Copy this file to .env and update values for your environment
# ===============================================

# ── Server Configuration ───────────────────────
PORT=5001
NODE_ENV=development
# Options: development | production | test

# ── Database Configuration ─────────────────────
# For local dev: mongodb://localhost:27017/acustock
# For production: mongodb+srv://<user>:<password>@cluster.mongodb.net/acustock?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/acustock

# ── JWT Authentication & Token Rotation ────────
# Generate cryptographically secure keys:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-256-bit-access-token-secret-change-this-in-production
JWT_REFRESH_SECRET=your-256-bit-refresh-token-secret-change-this-in-production
JWT_EXPIRE=15m

# ── Frontend & CORS Configuration ──────────────
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5001
# Canonical public frontend URL (used in email invite links & password resets)
FRONTEND_BASE_URL=http://localhost:3000

# ── Google OAuth 2.0 (Optional) ────────────────
# Leave blank to disable Google Sign-In
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# ── SMTP Email Relay (Nodemailer) ──────────────
# For Gmail: Use an App Password (not your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=AcuStock Support <noreply@acustock.com>

# ── Redis Cache (Optional) ─────────────────────
# If not set, system automatically uses in-memory fallback
REDIS_URL=redis://localhost:6379

# ── File Upload Configuration ──────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ── Object Storage (S3 / R2 / compatible) ──────
# Required in production when storing uploaded objects
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
QUOTA_RESERVATION_TTL_SECONDS=900

# Run these commands from a scheduler/container in production:
# npm run reconcile-usage
# npm run cleanup-quota-reservations
# npm run retry-billing-events
# npm run reconcile-billing

# ── Security & Account Policies ────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=300
LOCK_DURATION_MINUTES=15
SESSION_COOKIE_SECURE=false
# Set SESSION_COOKIE_SECURE=true when running behind HTTPS in production

# ── Logging Configuration ──────────────────────
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ── Billing Reliability ─────────────────────────
# Required when STRIPE_SECRET_KEY is configured
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_MAX_ATTEMPTS=5
PAYMENT_GRACE_PERIOD_DAYS=3
QUOTA_RESERVATION_TTL_SECONDS=900
