# ===============================================
# AcuStock - Git Ignore Configuration
# ===============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server.log
pm2-*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/
.nyc_output/

# Build output
dist/
build/

# IDE/Editor directories
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Optional npm cache
.npm

# Optional eslint cache
.eslintcache

# Temporary files
tmp/
temp/
*.tmp

# Uploads directory content (keep structure)
uploads/*
!uploads/.gitkeep

# Cookie/session files
cookies.txt
sessions/

# Test files
*.test.js
*.spec.js
__tests__/

# PM2 ecosystem local overrides
ecosystem.config.local.js

# Mac OS files
.DS_Store
.AppleDouble
.LSOverride

# Windows files
Thumbs.db
ehthumbs.db
