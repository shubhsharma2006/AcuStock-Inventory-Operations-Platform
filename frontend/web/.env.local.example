# ===============================================
# AcuStock Web Frontend Environment Template (.env.local)
# ===============================================
# Copy this file to .env.local and adjust for your local or production environment:
#   cp frontend/web/.env.local.example frontend/web/.env.local

# API Base URL (default connects to local Express backend proxied via Next.js rewrites)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/api
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5001

# Sentry Performance & Error Monitoring (Optional)
NEXT_PUBLIC_SENTRY_DSN=

# Google Maps Platform Key for Driver & Dispatch Live Fleet Map (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

